@startuml uc004-design-sequence-error
!include ../../../diagrams/style.iuml
title UC-004 Evaluate responses: design sequence (extensions 2a, 3a, 4a: no trustworthy verdict)

participant "runner._judge()" as Runner
participant ":Judge" as Judge
participant "connector:ModelConnector" as Conn
participant "judge.parse_verdict()" as Parse

Runner -> Judge : evaluate(case, actual_answer)
activate Judge
Judge -> Conn : generate(prompt, instructions)
alt 2a: the call fails
  Conn --> Judge : raises ConnectorError (auth, quota, rate limit, unavailable, ...)
  Judge --> Runner : raises JudgeError("judge call failed: ...")\nfrom the ConnectorError
else 3a: refusal or cut off
  Conn --> Judge : ModelResponse(text=None) or (truncated=True)
  Judge --> Runner : raises JudgeError("judge model refused to evaluate"\nor "judge reply was cut off by its length limit")
else 4a: unreadable reply
  Conn --> Judge : ModelResponse(text="I think it's fine")
  Judge -> Parse : parse_verdict(text)
  Parse --> Judge : raises JudgeError("judge reply is not valid JSON")
  Judge --> Runner : JudgeError propagates
end
deactivate Judge

Runner -> Runner : CaseResult(case, Outcome.ERROR, target,\nerror_stage="judge", error=str(e))
opt the cause was ConnectorAuthError or ConnectorQuotaError
  Runner -> Runner : remember judge_stopped_by: later cases are\nERROR "not judged: judging stopped after ..."
end
note over Runner
  Business rule: never FAIL without a verdict (AC-004-03).
end note
@enduml
