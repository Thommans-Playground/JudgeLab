@startuml uc001-design-sequence-profile
!include ../../../diagrams/style.iuml
title UC-001 Configure model connections: design sequence (steps 1 to 4, extensions 2a, 3a, 3b, 4a)

participant "config.load_config()" as Config
participant "ConnectionProfile" as CP
participant "registry.create_connector()" as Reg
participant ":AnthropicConnector" as Conn
participant "credentials.read_secret()" as Secret
participant "os.environ" as Env

Config -> CP : from_dict("judge", connections["judge"])
activate CP
alt 2a: unknown or missing settings
  CP --> Config : raises ProfileError("connection 'judge': unknown setting(s) ...;\nallowed: ...") or ("connection 'judge': missing ...")
else the keys are right
  CP -> CP : cls(name="judge", ~**data), then ~__post_init~__\ncollects every value problem
  opt 2a: blank, not a variable name, not https, out of range
    CP --> Config : raises ProfileError("connection 'judge': " + "; ".join(problems))
  end
  CP --> Config : profile: ConnectionProfile
end
deactivate CP
note right of Config
  load_config wraps any ProfileError
  as ConfigError("path: ...").
end note

[-> Reg : create_connector(profile)
activate Reg
Reg -> Reg : CONNECTORS[profile.provider]
opt 3a: unknown provider
  [<-- Reg : raises ProfileError("connection 'judge': unknown provider 'gemini';\nknown: anthropic, openai_compatible")
end
Reg -> Conn : AnthropicConnector(model=..., api_key_env=..., base_url=...,\ntimeout_s=..., max_retries=..., ~**profile.options)
activate Conn
opt 3b: an option the class does not accept
  Conn --> Reg : TypeError
  [<-- Reg : raises ProfileError("connection 'judge': unsupported option for anthropic: ...")
end
Conn -> Secret : read_secret(api_key_env)
Secret -> Env : get(env_name, "").strip()
alt 4a: missing, empty or only whitespace
  Secret --> Conn : raises ConnectorAuthError("environment variable NAME is not set")
else the key is set
  Secret --> Conn : key
end
Conn -> Conn : Anthropic(api_key=key, base_url=self.base_url,\ntimeout=timeout_s, max_retries=max_retries)
Conn --> Reg : connector
deactivate Conn
[<-- Reg : connector: ModelConnector
deactivate Reg
@enduml
