@startuml uc004-design-classes
!include ../../../diagrams/style.iuml
set namespaceSeparator none
hide empty members
title UC-004 Evaluate responses: design classes

package "judgelab.judge" {
  class Judge {
    +connector : ModelConnector
    +rubric : Rubric
    +instructions : str
    +evaluate(case: TestCase, actual_answer: str) : JudgeEvaluation
  }
  class Rubric <<dataclass, frozen>> {
    +id : str
    +instructions : str
  }
  enum Verdict {
    PASS
    FAIL
  }
  class JudgeEvaluation <<dataclass, frozen>> {
    +verdict : Verdict
    +justification : str
    +rubric_id : str
    +response : ModelResponse
  }
  class JudgeError <<exception>>
  class "judge functions" as JF <<function>> {
    +get_rubric(rubric_id: str) : Rubric
    +build_judge_prompt(case: TestCase, actual_answer: str) : str
    +parse_verdict(text: str) : tuple[Verdict, str]
  }
}

package "judgelab.connectors" {
  abstract class ModelConnector <<port>> {
    +provider : str
    +model : str
    +base_url : str | None
    +{abstract} generate(prompt: str, instructions: str | None) : ModelResponse
  }
  class ModelResponse <<dataclass, frozen>> {
    +text : str | None
    +refusal : str | None
    +requested_model : str
    +served_model : str
    +truncated : bool
  }
  class ConnectorError <<exception>>
  class OpenAIConnector <<adapter>>
  class AnthropicConnector <<adapter>>
  class FakeConnector <<adapter>>
}

package "judgelab.benchmark" {
  class TestCase <<dataclass, frozen>> {
    +id : str
    +question : str
    +expected_answer : str
  }
}

Judge --> "1" ModelConnector : connector
Judge --> "1" Rubric : rubric
Judge ..> JF : uses
Judge ..> TestCase : reads
Judge ..> JudgeEvaluation : creates
Judge ..> JudgeError : raises
JudgeEvaluation --> "1" Verdict
JudgeEvaluation --> "1" ModelResponse : judge call
ModelConnector ..> ModelResponse : returns
ModelConnector ..> ConnectorError : raises
OpenAIConnector --|> ModelConnector
AnthropicConnector --|> ModelConnector
FakeConnector --|> ModelConnector
JF ..> JudgeError : raises

note right of Judge
  instructions = rubric.instructions
  + OUTPUT_FORMAT, built once
  in __init__ (Strategy: the rubric
  is data the judge applies).
end note
@enduml
