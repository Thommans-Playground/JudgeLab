@startuml uc002-design-sequence-validation
!include ../../../diagrams/style.iuml
title UC-002 Prepare benchmark dataset: design sequence (extensions: every problem reported at once)

participant "cli.run_command()" as Run
participant "benchmark.load_benchmark()" as Load
participant "benchmark._check_fields()" as Check
participant "problems:list[str]" as PL

Run -> Load : load_benchmark(path)
activate Load
alt 1a or 2a: the file is missing or not JSON
  Load --> Run : raises BenchmarkError(path, ["file not found"])\nor (path, ["not valid JSON (line L, column C)"])
else 2b: the top level is not an object
  Load --> Run : raises BenchmarkError(path, ["the top level must be\nan object with id, name and cases"])
else the file parses: check everything, then decide
  Load -> Check : _check_fields(data, BENCHMARK_FIELDS, "benchmark", problems)
  Check -> PL : append("benchmark.id must be a non-empty string")
  Check --> Load : False
  opt 3b: cases missing, empty or not a list
    Load -> PL : append("cases must be a non-empty list")
  end
  loop for index, raw in enumerate(raw_cases)
    alt 4a: raw is not a dict
      Load -> PL : append("cases[1] must be an object")
    else 4b, 4c: a field is missing, blank or unknown
      Load -> Check : _check_fields(raw, CASE_FIELDS, "cases[i]", problems)
      Check -> PL : append unknown fields, then\nmissing or blank fields (sorted)
      Check --> Load : False (case skipped)
    else 4d: usable case whose id was seen before
      Load -> PL : append("cases[2].id 'c1' duplicates cases[0].id")
    end
  end
  Load --> Run : raises BenchmarkError(path, problems)
end
deactivate Load

Run -> Run : print "error: invalid benchmark PATH:"\nwith one "  - problem" line each, return 1
note over Run, PL
  Business rule: every problem from steps 3 and 4,
  in file order, in one error (AC-002-08).
end note
@enduml
