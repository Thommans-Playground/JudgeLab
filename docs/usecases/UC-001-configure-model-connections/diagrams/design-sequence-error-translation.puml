@startuml uc001-design-sequence-error-translation
!include ../../../diagrams/style.iuml
title UC-001 Configure model connections: design sequence (extensions 5a and 6b: failures become ConnectorError)

participant "caller" as Caller
participant ":OpenAIConnector" as Conn
participant "_client:openai.OpenAI" as SDK
participant "openai_connector.translate_error()" as TE

Caller -> Conn : generate(prompt, instructions=...)
activate Conn
Conn -> SDK : chat.completions.create(model, messages)
activate SDK
alt 5a: the SDK raises openai.APIError
  SDK --> Conn : raises e: openai.APIError
  deactivate SDK
  Conn -> TE : translate_error(e)
  activate TE
  alt APIConnectionError (APITimeoutError included)
    TE --> Conn : ConnectorUnavailableError("request timed out")\nor ("request connection failed")
  else APIStatusError: detail = "HTTP status (code)"
    TE -> TE : 401, 403: ConnectorAuthError\n402 or a QUOTA_ERROR_CODES code: ConnectorQuotaError\n429 otherwise: ConnectorRateLimitError\n500 and above, 408, 409: ConnectorUnavailableError\nany other status: ConnectorRequestError
    TE --> Conn : that error, with status_code and request_id
  else any other APIError
    TE --> Conn : ConnectorResponseError("unexpected SDK error: ...")
  end
  deactivate TE
  Conn --> Caller : raise translated from e
else 6b: the SDK returns something that is not a usable completion
  SDK --> Conn : completion
  Conn --> Caller : raises ConnectorResponseError("expected a chat completion, got ...")\nor ("response has no choices") or ("response has neither content nor refusal")
end
deactivate Conn

note over Caller, TE
  Business rule: a failure is always a ConnectorError, never an SDK exception (AC-001-06, AC-001-09).
  Messages carry the status, the provider's short code and the request id, never the key
  or the provider's free text (AC-001-08). AnthropicConnector has its own translate_error with
  the same mapping, reading the code from error.details.error_code in the body.
end note
@enduml
