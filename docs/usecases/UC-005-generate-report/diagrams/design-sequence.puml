@startuml uc005-design-sequence
!include ../../../diagrams/style.iuml
title UC-005 Generate report: design sequence (main success scenario)

participant "cli.run_command()" as CLI
participant "scoring.summarise()" as Summarise
participant "summary:Summary" as Summary
participant "run:RunInfo" as Run
participant "report.build_report()" as Build
participant "report.write_report()" as Write
participant "file system" as FS

note over CLI
  results : list[CaseResult] from runner.evaluate(),
  started, finished from report.utc_now() (UC-006).
end note
CLI -> Summarise : summarise(results)
activate Summarise
loop each result, once
  Summarise -> Summarise : counts[result.outcome] += 1; total += 1
end
Summarise --> CLI : Summary(total, passed, failed, errors)
deactivate Summarise
CLI -> Run ** : RunInfo(benchmark, rubric.id, target,\njudge_connector, started, finished)
note right of Run
  run_id defaults to uuid4().hex
end note
CLI -> Build : build_report(run, results, summary)
activate Build
Build -> Summary : evaluated, pass_rate, coverage
Summary --> Build : evaluated, pass_rate (or None), coverage
Build -> Build : _connection(run.target), _connection(run.judge)\n(provider, model, base_url only)
loop each result
  Build -> Build : _case(result), with _call(target)\nand _call(judgement.response)
end
Build --> CLI : report : dict (report_version "1", run, benchmark,\nrubric, connections, summary, cases)
deactivate Build
CLI -> Write : write_report(report, output_dir or config.output_dir)
activate Write
Write -> FS : directory.mkdir(parents=True, exist_ok=True)
Write -> Write : name = run-{started:%Y%m%dT%H%M%SZ}-{run id[:8]}.json
Write -> FS : path.write_text(json.dumps(report, indent=2,\nensure_ascii=False), encoding="utf-8")
Write --> CLI : path : Path
deactivate Write
@enduml
