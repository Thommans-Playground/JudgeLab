@startuml uc003-design-classes
!include ../../../diagrams/style.iuml
set namespaceSeparator none
hide empty members
title UC-003 Execute target model: design classes

package "judgelab.runner" {
  class "runner functions" as RF <<function>> {
    +run_target(benchmark: Benchmark, target: ModelConnector, on_result: Callable | None) : list[TargetResult]
    +evaluate(benchmark, target, judge, on_target: Callable | None, on_result: Callable | None) : list[CaseResult]
  }
  class TargetResult <<dataclass, frozen>> {
    +case : TestCase
    +response : ModelResponse | None
    +error : ConnectorError | None
  }
  class "STOP_THE_RUN" as STOP <<constant>> {
    ConnectorAuthError
    ConnectorQuotaError
  }
}

package "judgelab.benchmark" {
  class Benchmark <<dataclass, frozen>> {
    +cases : tuple[TestCase, ...]
  }
  class TestCase <<dataclass, frozen>> {
    +id : str
    +question : str
  }
}

package "judgelab.connectors" {
  abstract class ModelConnector <<port>> {
    +provider : str
    +model : str
    +{abstract} generate(prompt: str, instructions: str | None) : ModelResponse
  }
  class ModelResponse <<dataclass, frozen>> {
    +text : str | None
    +refusal : str | None
    +truncated : bool
  }
  class ConnectorError <<exception>> {
    +status_code : int | None
    +request_id : str | None
  }
  class ConnectorAuthError <<exception>>
  class ConnectorQuotaError <<exception>>
  class FakeConnector <<adapter>>
}

RF ..> Benchmark : iterates cases
RF --> ModelConnector : target.generate(case.question)
RF ..> TargetResult : creates, emits as CaseExecuted
RF ..> STOP : checks error against
TargetResult --> "1" TestCase : case
TargetResult --> "0..1" ModelResponse : response
TargetResult --> "0..1" ConnectorError : error
Benchmark *-- "1..*" TestCase
ModelConnector ..> ModelResponse : returns
ModelConnector ..> ConnectorError : raises
ConnectorAuthError --|> ConnectorError
ConnectorQuotaError --|> ConnectorError
FakeConnector --|> ModelConnector

note bottom of RF
  CaseExecuted event: run_target calls its
  on_result callback with each TargetResult.
  evaluate passes its own on_target callback
  in that slot: run_target(..., on_result=on_target).
end note
@enduml
