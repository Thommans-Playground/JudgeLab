@startuml uc001-design-sequence-claude
!include ../../../diagrams/style.iuml
title UC-001 Configure model connections: design sequence (steps 5 and 6, Claude connector)

participant "caller" as Caller
participant ":AnthropicConnector" as Conn
participant "_client:anthropic.Anthropic" as SDK
participant "Messages API" as API
participant ":ModelResponse" as Resp

Caller -> Conn : generate(prompt, instructions=...)
activate Conn
Conn -> Conn : messages = [user: prompt];\nextra = system=instructions, when instructions are set
Conn -> SDK : messages.create(model=self.model,\nmax_tokens=self.max_tokens, messages=messages, ~**extra)
activate SDK
SDK -> API : POST /v1/messages (once: max_retries=0)
API --> SDK : 200, JSON body
SDK --> Conn : message: Message
deactivate SDK
Conn -> Conn : check it is a Message
alt stop_reason == "refusal"
  Conn -> Conn : refusal = stop_details.explanation\nor "the model declined to answer"; text = None
else any other stop_reason
  Conn -> Conn : text = join of the "text" blocks\n(thinking and other blocks are skipped)
end
opt 6b: no text and no refusal
  Conn --> Caller : raises ConnectorResponseError("response has no text\nand no refusal (stop_reason=...)")
end
Conn -> Resp : ModelResponse(text, refusal, requested_model=self.model,\nserved_model=message.model, finish_reason=stop_reason or "unknown",\ntruncated=(stop_reason == "max_tokens"),\nprompt_tokens=usage.input_tokens, completion_tokens=usage.output_tokens,\nrequest_id=message._request_id, latency_ms)
Conn --> Caller : ModelResponse
deactivate Conn

note over Caller, Conn
  Same contract, different provider shape (AC-001-09, AC-001-11):
  the system prompt is a field, not a message; a refusal is a stop reason,
  not a field; truncation is "max_tokens", not "length".
end note
@enduml
