@startuml uc002-design-sequence
!include ../../../diagrams/style.iuml
title UC-002 Prepare benchmark dataset: design sequence (main success scenario)

participant "cli.run_command()" as Run
participant "benchmark.load_benchmark()" as Load
participant "path:Path" as File
participant "json.loads()" as Json
participant "benchmark._check_fields()" as Check
participant "TestCase" as TC
participant "Benchmark" as B

Run -> Load : load_benchmark(config.dataset)
activate Load
Load -> File : read_text(encoding="utf-8")
File --> Load : text
Load -> Json : loads(text)
Json --> Load : data (dict)
Load -> Check : _check_fields(data, BENCHMARK_FIELDS,\n"benchmark", problems)
Check --> Load : True
Load -> Load : raw_cases = data["cases"]\n(a non-empty list)
loop for index, raw in enumerate(raw_cases)
  Load -> Check : _check_fields(raw, CASE_FIELDS,\n"cases[index]", problems)
  Check --> Load : True
  Load -> TC : TestCase(raw["id"], raw["question"],\nraw["expected_answer"])
  TC --> Load : case
  Load -> Load : case.id not in first_seen:\nfirst_seen[case.id] = index
end
Load -> Load : problems is empty
Load -> B : Benchmark(id, name, cases=tuple(cases))
B --> Load : benchmark
Load --> Run : benchmark
deactivate Load

note over Run
  The benchmark is loaded before any connector
  is created, so a bad file never reaches a model.
end note
@enduml
