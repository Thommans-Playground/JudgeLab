@startuml uc005-analysis-sequence
!include ../../../diagrams/style.iuml
title UC-005 Generate report: analysis sequence (main success scenario)

control "Generate Report" as Gen
entity "Evaluation Run" as ER
entity "Case Result" as CR
entity "Run Summary" as RSum
entity "Report" as Rep
boundary "Report Store" as RS

[-> Gen : generate(evaluation run)
Gen -> ER : get case results
loop each case result, once
  Gen -> CR : get outcome
  Gen -> Gen : count it (PASS, FAIL or ERROR)
end
Gen -> RSum : create(total, passed, failed, errors)
RSum -> RSum : evaluated, pass rate, coverage
Gen -> ER : get id, benchmark, rubric,\nconnections, times
Gen -> Rep : build(run metadata, summary,\none entry per case result)
Gen -> RS : write(report)
RS --> Gen : report path
[<-- Gen : report path

note right of Rep
  Extensions 4a to 4c: a stage that did not
  happen is null in its case entry, and the
  error names its stage (target or judge).
end note
@enduml
