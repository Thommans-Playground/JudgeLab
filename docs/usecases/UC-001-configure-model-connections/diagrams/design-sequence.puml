@startuml uc001-design-sequence
!include ../../../diagrams/style.iuml
title UC-001 Configure model connections: design sequence (steps 5 and 6, OpenAI-compatible connector)

participant "caller\n(runner.run_target or Judge.evaluate)" as Caller
participant ":OpenAIConnector" as Conn
participant "_client:openai.OpenAI" as SDK
participant "OpenAI-compatible API" as API
participant ":ModelResponse" as Resp

note over Caller, Conn
  The connector was built from its profile
  (see design-sequence-profile).
end note

Caller -> Conn : generate(prompt, instructions=...)
activate Conn
Conn -> Conn : messages = [user: prompt],\nwith a "system" message first when instructions are set
Conn -> SDK : chat.completions.create(model=self.model, messages=messages)
activate SDK
SDK -> API : POST /chat/completions (once: max_retries=0)
API --> SDK : 200, JSON body
SDK --> Conn : completion: ChatCompletion
deactivate SDK
Conn -> Conn : latency_ms; check it is a ChatCompletion,\nhas choices, has content or refusal
alt the model answered
  Conn -> Resp : ModelResponse(text=content, refusal=None, ...)
else 6a: the model refused
  Conn -> Resp : ModelResponse(text=None, refusal=message.refusal, ...)
end
note right of Resp
  requested_model=self.model,
  served_model=completion.model,
  finish_reason=choice.finish_reason,
  truncated=(finish_reason == "length"),
  token counts from usage (None without it),
  request_id=completion._request_id
end note
Conn --> Caller : ModelResponse
deactivate Conn
@enduml
