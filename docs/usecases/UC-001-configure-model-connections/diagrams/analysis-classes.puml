@startuml uc001-analysis-classes
!include ../../../diagrams/style.iuml
hide empty members
hide circle
title UC-001 Configure model connections: analysis classes (BCE)

class "Configuration Interface" as CI <<boundary>> {
  read connection settings
}
class "Environment Interface" as EI <<boundary>> {
  read variable(name)
}
class "Provider Interface" as PI <<boundary>> {
  send request in the provider's own way
}
class "Configure Connection" as Conf <<control>> {
  configure(name, settings)
}
class "Call Model" as Call <<control>> {
  call(prompt, instructions)
}
class "Connection Profile" as CP <<entity>> {
  name (target or judge)
  provider
  model
  key variable name
  base URL
  timeout
  retries
  options
}
class "Provider" as Prov <<entity>> {
  name (openai_compatible or anthropic)
}
class "Credential" as Cred <<entity>> {
  variable name only
}
class "Model Response" as MR <<entity>> {
  text or refusal
  requested model
  served model
  finish reason
  truncated
  token counts
  request id
}
class "Connector Error" as CE <<entity>> {
  kind (auth, quota, rate limit,\nunavailable, request, response)
  HTTP status
  request id
}

CI --> Conf : settings
Conf --> CP : validates
CP --> Prov : names
CP --> Cred : references
Conf --> EI : resolves key through
Conf --> Call : configures
Call --> PI : sends through
Call --> MR : creates
Call --> CE : raises

note bottom of Cred
  Business rule: JudgeLab keeps only the
  variable's name. No entity ever holds
  the key's value.
end note
@enduml
