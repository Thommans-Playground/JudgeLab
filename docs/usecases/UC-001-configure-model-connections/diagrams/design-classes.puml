@startuml uc001-design-classes
!include ../../../diagrams/style.iuml
set namespaceSeparator none
hide empty members
title UC-001 Configure model connections: design classes

package "judgelab.connectors.profile" {
  class ConnectionProfile <<dataclass, frozen>> {
    +name : str
    +provider : str
    +model : str
    +api_key_env : str
    +base_url : str | None = None
    +timeout_s : float = 60.0
    +max_retries : int = 0
    +options : Mapping[str, object] = empty dict
    -~__post_init~__() : None
    +{static} from_dict(name: str, data: object) : ConnectionProfile
  }
  class ProfileError <<exception>>
}

package "judgelab.connectors.registry" {
  class "registry.create_connector" as Reg <<function>> {
    +CONNECTORS : dict[str, type[ModelConnector]]
    +create_connector(profile: ConnectionProfile) : ModelConnector
  }
}

package "judgelab.connectors.credentials" {
  class "credentials.read_secret" as Secret <<function>> {
    +read_secret(env_name: str) : str
  }
}

package "judgelab.connectors.base" {
  abstract class ModelConnector <<port>> {
    +{static} provider : str
    +{static} default_base_url : str | None
    +model : str
    +base_url : str | None
    +{abstract} generate(prompt: str, *, instructions: str | None = None) : ModelResponse
    +~__repr~__() : str
  }
}

package "judgelab.connectors (adapters)" {
  class OpenAIConnector <<adapter>> {
    provider = "openai_compatible"
    -_client : openai.OpenAI
    +generate(prompt, *, instructions) : ModelResponse
  }
  class AnthropicConnector <<adapter>> {
    provider = "anthropic"
    +max_tokens : int = 16000
    -_client : anthropic.Anthropic
    +generate(prompt, *, instructions) : ModelResponse
  }
  class FakeConnector <<adapter>> {
    provider = "fake"
    +replies : dict[str, Reply]
    +default : Reply | None
    +prompts : list[str]
    +instructions : list[str | None]
    +generate(prompt, *, instructions) : ModelResponse
  }
}

package "judgelab.connectors.response" {
  class ModelResponse <<dataclass, frozen>> {
    +text : str | None
    +refusal : str | None
    +requested_model : str
    +served_model : str
    +finish_reason : str
    +truncated : bool
    +prompt_tokens : int | None
    +completion_tokens : int | None
    +request_id : str | None
    +latency_ms : float
  }
}

package "judgelab.connectors.errors" {
  class ConnectorError <<exception>> {
    +status_code : int | None
    +request_id : str | None
  }
}

ConnectionProfile ..> ProfileError : raises
Reg ..> ConnectionProfile : reads
Reg ..> ModelConnector : creates
Reg ..> ProfileError : raises
OpenAIConnector --|> ModelConnector
AnthropicConnector --|> ModelConnector
FakeConnector --|> ModelConnector
OpenAIConnector ..> Secret : key from
AnthropicConnector ..> Secret : key from
Secret ..> ConnectorError : raises ConnectorAuthError
ModelConnector ..> ModelResponse : returns
ModelConnector ..> ConnectorError : raises

note right of Reg
  CONNECTORS maps provider to class:
  "openai_compatible" to OpenAIConnector,
  "anthropic" to AnthropicConnector.
  FakeConnector is not registered:
  tests build it directly.
end note

note bottom of ConnectorError
  Six subclasses: ConnectorAuthError, ConnectorQuotaError,
  ConnectorRateLimitError, ConnectorUnavailableError,
  ConnectorRequestError, ConnectorResponseError.
end note
@enduml
