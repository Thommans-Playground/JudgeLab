@startuml uc003-design-sequence
!include ../../../diagrams/style.iuml
title UC-003 Execute target model: design sequence (main success scenario)

participant "runner.evaluate()" as Eval
participant "runner.run_target()" as Run
participant "target:ModelConnector" as Conn
participant "TargetResult" as TR
participant "on_target callback" as OnT

Eval -> Run : run_target(benchmark, target,\non_result=on_target)
activate Run
loop for case in benchmark.cases (stopped_by is None)
  Run -> Conn : generate(case.question)
  activate Conn
  Conn --> Run : ModelResponse(text="Paris", truncated=False, ...)
  deactivate Conn
  Run -> TR : TargetResult(case, response, None)
  TR --> Run : result
  Run -> Run : results.append(result)
  opt on_result is not None
    Run -> OnT : on_result(result)
    note right of OnT
      CaseExecuted event (in-process,
      synchronous). The CLI does not
      subscribe in v0.1; tests do.
    end note
  end
end
Run --> Eval : results (list[TargetResult], benchmark order)
deactivate Run
Eval -> Eval : _judge(answered, ...) for each result (UC-004)

note over Run, Conn
  3a: a refusal (text=None, refusal set) or a cut-off answer
  (truncated=True) is still a ModelResponse, recorded as one.
  runner._judge decides what it means.
end note
@enduml
