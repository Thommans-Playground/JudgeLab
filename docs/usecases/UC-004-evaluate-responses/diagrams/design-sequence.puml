@startuml uc004-design-sequence
!include ../../../diagrams/style.iuml
title UC-004 Evaluate responses: design sequence (main success scenario)

participant "runner._judge()" as Runner
participant ":Judge" as Judge
participant "judge.build_judge_prompt()" as Build
participant "connector:ModelConnector" as Conn
participant "judge.parse_verdict()" as Parse

Runner -> Judge : evaluate(case, actual_answer)
activate Judge
Judge -> Build : build_judge_prompt(case, actual_answer)
Build --> Judge : prompt (question, expected_answer,\nactual_answer in tags)
Judge -> Conn : generate(prompt, instructions=self.instructions)
activate Conn
note right of Conn
  The adapter sends instructions its own way:
  OpenAI "system" message, Claude "system" field,
  Fake records them (AC-004-06).
end note
Conn --> Judge : ModelResponse(text, served_model, ...)
deactivate Conn
Judge -> Judge : check text is not None, not truncated
Judge -> Parse : parse_verdict(response.text)
Parse --> Judge : (Verdict.PASS, justification)
Judge --> Runner : JudgeEvaluation(verdict, justification,\nrubric.id, response)
deactivate Judge
Runner -> Runner : CaseResult(case, Outcome(verdict),\ntarget, judgement)
@enduml
